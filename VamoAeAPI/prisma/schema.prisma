generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  fullname String
  email    String
  whatsapp String
  password    String

   rides    Rides[]
}

model Rides {
  id          String   @id @default(uuid())
  origin      String
  destination String
  whatsapp String
  value Int?
  date        String
  time        String
  isRideRequest Boolean @default(false)

  userId      String                      // <= FK
  user        User     @relation(fields: [userId], references: [id])
}


